# Candidate only: render, validate and test the complete configuration before
# replacing the separately managed txy edge configuration.
global
    log stdout format raw local0

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 1m
    timeout server 1m

frontend edge_http
    bind {{ shirone_edge_bind_address }}:{{ shirone_edge_http_port }}
    default_backend traefik_http

backend traefik_http
    server local_traefik {{ shirone_edge_traefik_address }}:{{ shirone_edge_traefik_http_port }} send-proxy-v2 check

frontend edge_https
    bind {{ shirone_edge_bind_address }}:{{ shirone_edge_https_port }}
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    acl shirone_site req.ssl_sni -i hyperbola.cc www.hyperbola.cc blog.hyperbola.cc strapi.hyperbola.cc
    use_backend shirone_https if shirone_site
    default_backend traefik_https

backend traefik_https
    server local_traefik {{ shirone_edge_traefik_address }}:{{ shirone_edge_traefik_https_port }} send-proxy-v2 check

backend shirone_https
    # PROXY v2 is opt-in: the isolated gateway must explicitly accept it.
    server shirone_tunnel 127.0.0.1:{{ shirone_edge_tunnel_port }}{% if shirone_edge_send_proxy | default(false) %} send-proxy-v2{% endif %} check
